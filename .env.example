# Postgres connection string. On Railway, add a Postgres service and set this
# variable on the web service to ${{Postgres.DATABASE_URL}}.
# Locally: any Postgres, e.g. postgres://postgres:postgres@localhost:5432/lowvision
DATABASE_URL=

# Set to "require" only when connecting over Railway's public Postgres URL.
# PGSSLMODE=require

# Host used for the www → apex redirect (defaults to lowvisionnavigator.org)
# CANONICAL_HOST=lowvisionnavigator.org

# AI assistant (/api/chat) — OpenAI GPT-6 Luna. Server-side only: never prefix
# with VITE_. On Railway, add it under the web service's Variables.
OPENAI_API_KEY=
# Optional overrides:
# CHAT_MODEL=gpt-6-luna
# CHAT_EFFORT=medium   # low | medium | high

# Read access to contact-form messages and page-view stats via
# GET /api/admin/contact-messages and GET /api/admin/stats
# (send "Authorization: Bearer <token>"). Use a long random value, 16+ chars.
# Leave unset to disable those endpoints.
# ADMIN_TOKEN=
