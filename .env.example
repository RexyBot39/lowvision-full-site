# Postgres connection string. On Railway, add a Postgres service and set this
# variable on the web service to ${{Postgres.DATABASE_URL}}.
# Locally: any Postgres, e.g. postgres://postgres:postgres@localhost:5432/lowvision
DATABASE_URL=

# Set to "require" only when connecting over Railway's public Postgres URL.
# PGSSLMODE=require

# Host used for the www → apex redirect (defaults to lowvisionnavigator.org)
# CANONICAL_HOST=lowvisionnavigator.org

# AI assistant (/api/chat) — OpenAI GPT-6 Luna. Server-side only: never prefix
# with VITE_. On Railway, add it under the web service's Variables.
OPENAI_API_KEY=
# Optional overrides:
# CHAT_MODEL=gpt-6-luna
# CHAT_EFFORT=medium   # low | medium | high


# ── Admin dashboard (/admin) ──
# Signed-in accounts with these emails can open /admin (comma-separated).
# ADMIN_EMAILS=you@example.org,colleague@example.org
# Optional: lets scripts call /api/admin/* with "Authorization: Bearer <token>".
# Use a long random value (16+ chars). Leave unset to allow admin accounts only.
# ADMIN_TOKEN=

# ── PostHog analytics (optional; without it the built-in page counter is used) ──
# Project API key (phc_…): turns on collection. Public by design.
# POSTHOG_PROJECT_KEY=
# "us" (default) or "eu", matching your PostHog cloud region.
# POSTHOG_REGION=us
# For the /admin dashboard: project id (the number in your PostHog URL) and a
# personal API key (phx_…) with the "query:read" scope. Server-side only.
# POSTHOG_PROJECT_ID=
# POSTHOG_PERSONAL_API_KEY=

# ── SEO tab in /admin (DataForSEO) ──
# API credentials from https://app.dataforseo.com/api-access (not your account password).
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# Optional:
# SEO_TARGET=lowvisionnavigator.org   # domain to analyse (defaults to CANONICAL_HOST)
# SEO_LOCATION_CODE=2840              # 2840 United States, 2124 Canada
# SEO_LANGUAGE_CODE=en
# SEO_KEYWORD_LIMIT=1000              # ranked keywords per snapshot (1–1000)
# SEO_AUTO_REFRESH_DAYS=7             # automatic snapshot interval; 0 turns it off
